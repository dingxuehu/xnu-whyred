@@ -223,6 +223,30 @@
 	b	EXT(start_first_cpu)
 
 
+#if defined(SWEET)
+/*
+ * whyred bring-up markers. The panel is 1080x2160, so only rows < 2160 are
+ * visible (patch 0010 draws its stage-0 band at row 2368: never on screen).
+ * SWEET_BAND paints a 64x32 band with x6-x11 only, so it works with the MMU
+ * off, before any page table or stack exists, and never clobbers live state.
+ */
+.macro SWEET_BAND row, color
+	MOV64	x6, (0x9d400000 + (\row) * 4320)
+	MOV64	x7, \color
+	mov		x8, #32
+	mov		x9, #4320
+1:	mov		x10, #64
+	mov		x11, x6
+2:	str		w7, [x11], #4
+	subs	x10, x10, #1
+	b.ne	2b
+	add		x6, x6, x9
+	subs	x8, x8, #1
+	b.ne	1b
+	dsb		sy
+.endm
+#endif
+
