 #if defined(SWEET)
 	/*
@@ -1311,6 +1287,127 @@
 	b.lo	9b
 	dsb		sy
 	/* whyred C6: image and page tables invalidated from the D-cache */
+#if defined(SWEET)
+/*
+ * whyred 0114: a band whose colour comes from a register, at an x offset.  The
+ * original SWEET_BAND_V always starts at panel x = 0, which is why every check
+ * so far needed a free row of its own; this one can put several checks in one
+ * row.  Everything else is identical, including the register discipline: only
+ * x6..x11 are touched, and the caller's colour register is copied to x7 before
+ * x10 is reused as the inner counter.  It has to be defined before the checks
+ * below use it -- .macro is expanded where it is written, not where it ends up
+ * in the file.
+ */
+.macro SWEET_BAND_X row, xoff, colreg
+	MOV64	x6, (0x9d400000 + (\row) * 4320 + (\xoff) * 4)
+	mov		x7, \colreg
+	mov		x8, #32
+	mov		x9, #4320
+1:	mov		x10, #64
+	mov		x11, x6
+2:	str		w7, [x11], #4
+	subs	x10, x10, #1
+	b.ne	2b
+	add		x6, x6, x9
+	subs	x8, x8, #1
+	b.ne	1b
+	dsb		sy
+.endm
+#endif
+#if defined(SWEET)
+	/*
+	 * whyred 0114: is the V=P block that contains this very code executable?
+	 *
+	 * 0112 established by AT S1E1R that the code's own address walks and that
+	 * L2[88] is valid|block -- but AT tests DATA READ permission at EL1 and
+	 * says nothing about instruction fetch, which is what PXN (bit 53) and NX
+	 * (bit 54) control.  A block with PXN set faults the first fetch after
+	 * SCTLR_EL1.M goes to 1, and that would look exactly like the silent death
+	 * this port has been chasing.  This build does not write the table unless
+	 * it has first proved it is reading the table.
+	 *
+	 * x25 is the PA of the V=P L1 root.  With a 16KB granule and T0SZ=17,
+	 * L1[0] spans 0x0..0xFFFFFFFF and each L2 entry is 32MB, so the 32MB block
+	 * holding this code (0xB0000000) is index 88.  The table address is
+	 * bits[47:14], so the mask is spelled out rather than taken from a header
+	 * that might be defined for a different granule.
+	 *
+	 * Five patches, side by side in row 640 at x = 16, 240, 464, 688, 912.
+	 * Green means the property holds:
+	 *   x=16    L1[0] is a table descriptor  (black: the rest mean nothing and
+	 *                                         nothing is written back)
+	 *   x=240   L2[88] is valid | block      (0112 proved this, so black here
+	 *                                         means the read path is wrong)
+	 *   x=464   L2[88] access flag is set
+	 *   x=688   L2[88] PXN is set, bit 53
+	 *   x=912   L2[88] NX is set, bit 54
+	 *
+	 * Only x4..x11 are touched.  x22/x23 are needed to form VBAR_EL1 below and
+	 * are left alone.
+	 */
+	ldr		x4, [x25]			/* L1[0] */
+	MOV64	x5, 0x0000FFFFFFFFC000		/* table address is bits[47:14] */
+	and		x5, x4, x5			/* -> the V=P L2 table */
+	and		x9, x4, #0x3
+	cmp		x9, #0x3			/* a table descriptor? */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	csel	x6, x7, x8, eq
+	SWEET_BAND_X 640, 16, x6
+	and		x9, x4, #0x3
+	cmp		x9, #0x3
+	b.ne		.Lw0114_no_table
+	ldr		x4, [x5, #(88 * 8)]		/* the kernel's 32MB block */
+	/* x=240: valid | block */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	and		x9, x4, #0x3
+	cmp		x9, #0x1
+	csel	x6, x7, x8, eq
+	SWEET_BAND_X 640, 240, x6
+	/* x=464: access flag, bit 10 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	tst		x4, #0x400
+	csel	x6, x7, x8, ne
+	SWEET_BAND_X 640, 464, x6
+	/* x=688: PXN, bit 53 -- green here would be the killer */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	MOV64	x9, 0x0020000000000000
+	tst		x4, x9
+	csel	x6, x7, x8, ne
+	SWEET_BAND_X 640, 688, x6
+	/* x=912: NX, bit 54 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	MOV64	x9, 0x0040000000000000
+	tst		x4, x9
+	csel	x6, x7, x8, ne
+	SWEET_BAND_X 640, 912, x6
+	/* Make that block executable and publish the change to the walker. */
+	MOV64	x7, 0xffdfffffffffffff		/* ~(1 << 53): clear PXN */
+	and		x4, x4, x7
+	MOV64	x7, 0xffbfffffffffffff		/* ~(1 << 54): clear NX */
+	and		x4, x4, x7
+	str		x4, [x5, #(88 * 8)]
+	dsb		sy
+	tlbi		vmalle1
+	dsb		sy
+	isb		sy
+.Lw0114_no_table:
+	/*
+	 * Arm the fault reporter before translation is enabled.  The kernel's own
+	 * vectors are not installed until after the two SCTLR writes below, so at
+	 * that instant VBAR_EL1 still holds what the shim or ABL left there --
+	 * normally 0.  adr, not adrp: with the MMU off the code runs at its
+	 * physical address, so adr yields exactly what a V=P-mapped VBAR_EL1
+	 * needs.  0112 proved adr works here with its own-PC AT probe.
+	 */
+	adr		x0, .Lw0114_vectors
+	MSR_VBAR_EL1_X0
+	isb		sy
+#endif
 	SWEET_BAND 360, 0xff7fff00
 #endif
 #if defined(SWEET)
@@ -1469,6 +1566,211 @@
 	/* Return to arm_init() */
 	ret
 
+/*
+ * whyred 0114: the fault reporter.  All 16 vector entries branch here.
+ *
+ * The handler may be entered with a translation regime that has just failed,
+ * so it reads the syndrome first, then immediately turns the MMU off so that
+ * VA == PA again, and only then writes its report straight to the framebuffer
+ * at the same absolute physical address every other SWEET band uses.
+ *
+ * Band map, left edge, 32 rows each:
+ *   860  white    the reporter ran at all
+ *   900  colour   ESR_EL1.EC: magenta = instruction abort, cyan = data abort,
+ *                 yellow = trapped system register, blue = illegal execution
+ *                 state, green = something else
+ *   940  colour   ESR_EL1[5:2]: white = translation fault, cyan = permission
+ *                 fault, yellow = address size fault, green = access flag
+ *                 fault, blue = other
+ *   980  colour   ESR_EL1[1:0]: white = level 0, green = level 1,
+ *                 cyan = level 2, yellow = level 3
+ *   1140 green    FAR_EL1 in the framebuffer's 16MB (0x9d......)
+ *   1180 green    FAR_EL1 in the kernel image's 16MB (0xb1......)
+ *   1220 green    FAR_EL1 below 64KB, i.e. something vectored to zero
+ *   1260 green    FAR_EL1 in this vector table's own page
+ *   1300..1580    FAR_EL1[39:32], MSB first: green = 1, black = 0
+ *   1620 green    ESR_EL1.WnR, the faulting access was a write
+ *   1660 green    ELR_EL1 in the kernel image's 16MB, the fault is ours
+ *
+ * x12..x15 carry the captured registers across the band calls because
+ * SWEET_BAND_V only ever uses x6..x11; those are reloaded for every band.
+ *
+ * Rows 1640..1740 are deliberately left alone: 0112's own bit bar lives there,
+ * which is exactly what made 0113's readings ambiguous.
+ */
+	.align 11				/* VBAR_EL1 requires 2KB alignment */
+.Lw0114_vectors:
+	.rept 16
+	b		.Lw0114_report
+	.space 0x7c, 0
+	.endr
+
+.Lw0114_report:
+	mrs		x12, esr_el1			/* capture before anything else */
+	mrs		x13, far_el1
+	mrs		x14, elr_el1
+	mrs		x15, spsr_el1
+	mrs		x9, sctlr_el1
+	bic		x9, x9, #1			/* SCTLR_EL1.M = 0 */
+	msr		sctlr_el1, x9
+	isb		sy
+	/* 860: did the reporter run? */
+	MOV64	x6, 0xffffffff
+	SWEET_BAND_V 860, x6
+	/* 900: exception class */
+	ubfx	x9, x12, #26, #6
+	MOV64	x7, 0xffff00ff			/* magenta: instruction abort */
+	MOV64	x8, 0xff00ffff			/* cyan:    data abort */
+	MOV64	x10, 0xffffff00			/* yellow:  trapped system register */
+	MOV64	x11, 0xff0000ff			/* blue:    illegal execution state */
+	MOV64	x6, 0xff00ff00			/* green:   something else */
+	cmp		x9, #0x20
+	csel	x6, x7, x6, eq
+	cmp		x9, #0x21
+	csel	x6, x7, x6, eq
+	cmp		x9, #0x24
+	csel	x6, x8, x6, eq
+	cmp		x9, #0x25
+	csel	x6, x8, x6, eq
+	cmp		x9, #0x18
+	csel	x6, x10, x6, eq
+	cmp		x9, #0x0e
+	csel	x6, x11, x6, eq
+	SWEET_BAND_V 900, x6
+	/* 940: fault status class */
+	ubfx	x9, x12, #2, #4
+	MOV64	x7, 0xffffffff			/* white:  translation fault */
+	MOV64	x8, 0xff00ffff			/* cyan:   permission fault */
+	MOV64	x10, 0xffffff00			/* yellow: address size fault */
+	MOV64	x11, 0xff00ff00			/* green:  access flag fault */
+	MOV64	x6, 0xff0000ff			/* blue:   other */
+	cmp		x9, #0x4
+	csel	x6, x7, x6, eq
+	cmp		x9, #0xc
+	csel	x6, x8, x6, eq
+	cmp		x9, #0x0
+	csel	x6, x10, x6, eq
+	cmp		x9, #0x8
+	csel	x6, x11, x6, eq
+	SWEET_BAND_V 940, x6
+	/* 980: fault level */
+	and		x9, x12, #3
+	MOV64	x7, 0xffffffff			/* white:  level 0 */
+	MOV64	x8, 0xff00ff00			/* green:  level 1 */
+	MOV64	x10, 0xff00ffff			/* cyan:   level 2 */
+	MOV64	x11, 0xffffff00			/* yellow: level 3 */
+	mov		x6, x7
+	cmp		x9, #1
+	csel	x6, x8, x6, eq
+	cmp		x9, #2
+	csel	x6, x10, x6, eq
+	cmp		x9, #3
+	csel	x6, x11, x6, eq
+	SWEET_BAND_V 980, x6
+	/* 1140: is the faulting address in the framebuffer's 16MB? */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	lsr		x9, x13, #24
+	cmp		x9, #0x9d
+	csel	x6, x7, x8, eq
+	SWEET_BAND_V 1140, x6
+	/* 1180: is it in the kernel image's 16MB? */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	lsr		x9, x13, #24
+	cmp		x9, #0xb1
+	csel	x6, x7, x8, eq
+	SWEET_BAND_V 1180, x6
+	/* 1220: is it below 64KB? */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	lsr		x9, x13, #16
+	cmp		x9, #0
+	csel	x6, x7, x8, eq
+	SWEET_BAND_V 1220, x6
+	/* 1260: is it in this vector table's own page? */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	adr		x10, .Lw0114_vectors
+	lsr		x9, x13, #12
+	lsr		x10, x10, #12
+	cmp		x9, x10
+	csel	x6, x7, x8, eq
+	SWEET_BAND_V 1260, x6
+	/* 1300..1580: FAR_EL1[39:32], most significant bit first */
+	/* 1300: FAR_EL1 bit 39 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #39, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1300, x6
+	/* 1340: FAR_EL1 bit 38 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #38, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1340, x6
+	/* 1380: FAR_EL1 bit 37 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #37, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1380, x6
+	/* 1420: FAR_EL1 bit 36 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #36, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1420, x6
+	/* 1460: FAR_EL1 bit 35 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #35, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1460, x6
+	/* 1500: FAR_EL1 bit 34 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #34, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1500, x6
+	/* 1540: FAR_EL1 bit 33 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #33, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1540, x6
+	/* 1580: FAR_EL1 bit 32 */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x13, #32, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1580, x6
+	/* 1620: was the faulting access a write? */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	ubfx	x9, x12, #6, #1
+	cmp		x9, #0
+	csel	x6, x7, x8, ne
+	SWEET_BAND_V 1620, x6
+	/* 1660: was the interrupted PC in the kernel image? */
+	MOV64	x7, 0xff00ff00
+	MOV64	x8, 0xff000000
+	lsr		x9, x14, #24
+	cmp		x9, #0xb1
+	csel	x6, x7, x8, eq
+	SWEET_BAND_V 1660, x6
+.Lw0114_hang:
+	wfi
+	b		.Lw0114_hang
 //#include	"globals_asm.h"
 
